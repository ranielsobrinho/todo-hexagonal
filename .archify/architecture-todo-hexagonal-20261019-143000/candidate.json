    },
    "legend": {
      "mode": "auto",
      "entries": {
        "backend": { "label": "Application Layer", "visible": true },
        "database": { "label": "Domain / Infrastructure", "visible": true },
        "external": { "label": "Interfaces (HTTP/gRPC)", "visible": true },
        "security": { "label": "Cross-cutting", "visible": true }
      }
    },
    "views": [
      {
        "id": "overview",
        "label": "Full Architecture",
        "focus": [
          "todoEntity",
          "iTodoRepo",
          "contracts",
          "appErrors",
          "useCases",
          "pgRepo",
          "dbPool",
          "envConfig",
          "httpAdapter",
          "grpcAdapter",
          "main"
        ],
        "note": "Complete hexagonal architecture"
      },
      {
        "id": "domain",
        "label": "Domain Core",
        "focus": ["todoEntity", "iTodoRepo", "contracts", "appErrors"],
        "note": "Pure domain: entities, ports, contracts"
      },
      {
        "id": "app",
        "label": "Application Layer",
        "focus": ["useCases", "iTodoRepo", "todoEntity", "appErrors"],
        "note": "Use cases depending on domain ports"
      },
      {
        "id": "infra",
        "label": "Infrastructure",
        "focus": ["pgRepo", "dbPool", "envConfig", "iTodoRepo"],
        "note": "Database and config adapters"
      },
      {
        "id": "adapters",
        "label": "Interface Adapters",
        "focus": ["httpAdapter", "grpcAdapter", "useCases", "main"],
        "note": "HTTP and gRPC adapters"
      }
