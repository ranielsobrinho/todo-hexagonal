  "boundaries": [
    {
      "kind": "region",
      "label": "Domain Layer",
      "wraps": ["todoEntity", "iTodoRepo", "contracts", "appErrors"],
      "pad": 15
    },
    {
      "kind": "region",
      "label": "Application Layer",
      "wraps": ["useCases"],
      "pad": 15
    },
    {
      "kind": "region",
      "label": "Infrastructure Layer",
      "wraps": ["pgRepo", "dbPool", "envConfig"],
      "pad": 15
    },
    {
      "kind": "region",
      "label": "Interface Adapters",
      "wraps": ["httpAdapter", "grpcAdapter"],
      "pad": 15
    }
  ],
  "connections": [
    {
      "id": "uc-repo",
      "from": "useCases",
      "to": "iTodoRepo",
      "label": "depends on (port)"
    },
    {
      "id": "uc-entity",
      "from": "useCases",
      "to": "todoEntity",
      "label": "creates/returns"
    },
    {
      "id": "uc-errors",
      "from": "useCases",
      "to": "appErrors",
      "label": "throws"
    },
    {
      "id": "contracts-uc",
      "from": "contracts",
      "to": "useCases",
      "label": "implemented by"
    },
    {
      "id": "pgRepo-implements",
      "from": "pgRepo",
      "to": "iTodoRepo",
      "label": "implements",
      "variant": "emphasis"
    },
    {
      "id": "pgRepo-entity",
      "from": "pgRepo",
      "to": "todoEntity",
      "label": "maps to/from"
    },
    { "id": "pgRepo-pool", "from": "pgRepo", "to": "dbPool", "label": "uses" },
    {
      "id": "pgRepo-errors",
      "from": "pgRepo",
      "to": "appErrors",
      "label": "throws"
    },
    {
      "id": "http-uc",
      "from": "httpAdapter",
      "to": "useCases",
      "label": "uses"
    },
    {
      "id": "grpc-uc",
      "from": "grpcAdapter",
      "to": "useCases",
      "label": "uses"
    },
    {
      "id": "main-http",
      "from": "main",
      "to": "httpAdapter",
      "label": "starts"
    },
    {
      "id": "main-grpc",
      "from": "main",
      "to": "grpcAdapter",
      "label": "starts"
    },
    {
      "id": "main-db",
      "from": "main",
      "to": "dbPool",
      "label": "checks connection"
    },
    {
      "id": "main-env",
      "from": "main",
      "to": "envConfig",
      "label": "reads config"
    }
  ],
