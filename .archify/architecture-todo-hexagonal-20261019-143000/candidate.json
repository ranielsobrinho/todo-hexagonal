    {
      "id": "main",
      "type": "external",
      "label": "Main Entry",
      "sublabel": "Boots HTTP + gRPC servers",
      "row": 5,
      "col": 2,
      "icon": "start",
      "sources": [{ "path": "src/main.ts", "line": 1 }]
